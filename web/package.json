{
  "name": "narxoz-firebase",
  "private": true,
  "scripts": {
    "build:sdk": "esbuild firebase/sdk.js --bundle --format=esm --minify --outfile=frontend/js/vendor/firebase.js",
    "test:rules": "firebase emulators:exec --project demo-narxoz --only auth,firestore,storage \"node --test tests/firebase.test.mjs\"",
    "test:auth": "firebase emulators:exec --project demo-narxoz --only auth \"node --test tests/auth.test.mjs\""
  },
  "dependencies": {
    "firebase": "11.10.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "4.0.1",
    "esbuild": "0.25.5",
    "firebase-tools": "14.7.0"
  }
}
